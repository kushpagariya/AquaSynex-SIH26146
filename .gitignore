# ==============================================================================
# AquaSynex - .gitignore
# SIH26146: AI-Powered Monitoring & Analysis of Bitcoin Transaction Traffic
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.cert

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments (local and backend)
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
.Python
bin/
lib/
include/

# Packaging & distribution
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Testing, coverage & linting
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# ------------------------------------------------------------------------------
# Node / Frontend (React + Vite)
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Frontend build outputs
frontend/dist/
frontend/dist-ssr/
dist/
dist-ssr/

# Vite / bundler / linter caches
.vite/
.eslintcache
.stylelintcache
.turbo/

# ------------------------------------------------------------------------------
# Databases, Datasets & Storage
# ------------------------------------------------------------------------------
# DuckDB and SQLite database files
*.db
*.db.wal
*.duckdb
*.duckdb.wal
*.sqlite
*.sqlite3

# Runtime database directory files (keep structure via .gitkeep)
/backend/db/*.db
/backend/db/*.wal
/db/*.db
/db/*.wal

# Raw data and uploaded datasets (keep directory structure with .gitkeep)
/data/*
!/data/.gitkeep
backend/data/*
!backend/data/.gitkeep

# Large dataset files & archives
*.parquet
*.feather
*.arrow
*.csv.gz
*.tar.gz

# ------------------------------------------------------------------------------
# Machine Learning Model Artifacts
# ------------------------------------------------------------------------------
# Serialized models, scalers, and binaries (keep metadata JSON / configs)
*.pkl
*.pickle
*.joblib
*.onnx
*.pt
*.pth
*.h5
*.bin
*.model

# Model artifact directories (allow tracked .gitkeep and metadata files)
/models/*
!/models/.gitkeep
!/models/**/model_metadata.json
!/models/**/evaluation_report.json
!/models/**/feature_importance.json

# ------------------------------------------------------------------------------
# Logs & Temporary Files
# ------------------------------------------------------------------------------
*.log
logs/
*.tmp
*.temp
/tmp/

# ------------------------------------------------------------------------------
# OS-Specific Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ------------------------------------------------------------------------------
# IDE & Editor Files
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (PyCharm, WebStorm, etc.)
.idea/

# Vim / Emacs
*.swp
*.swo
*~
\#*\#
.#*

# ------------------------------------------------------------------------------
# Docker
# ------------------------------------------------------------------------------
docker-compose.override.yml
