# ==============================================================================
# AquaSynex - Environment Configuration Template
# SIH26146: AI-Powered Monitoring & Analysis of Bitcoin Transaction Traffic
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# ── Backend Configuration ─────────────────────────────────────────────────────

# Database: Path to DuckDB database file
# Docker default: /app/db/aquasynex.db
# Local dev example: ./backend/db/aquasynex.db or data/aquasynex.db
DB_PATH=/app/db/aquasynex.db

# Storage Directories
# Docker defaults: /app/data and /app/models (mapped to persistent volumes)
# Local dev examples: ./data and ./models
DATA_DIR=/app/data
MODELS_DIR=/app/models

# API & CORS Settings
# Comma-separated list of allowed origins (e.g., Vite dev server on :5173, production on :3000)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Maximum upload file size in bytes (2 GB default)
MAX_UPLOAD_SIZE_BYTES=2147483648

# Machine Learning Defaults
DEFAULT_MODEL_ID=isolation_forest_v1
DEFAULT_MODEL_VERSION=1.0.0
DEFAULT_TOP_EXPLANATIONS=5
DEFAULT_MAX_ENTITIES=10000

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ── Frontend Build Configuration ──────────────────────────────────────────────

# Backend API URL (embedded at build time by Vite, visible in client bundle)
VITE_API_BASE_URL=http://localhost:8000/api

# ── Reverse Proxy / Docker Compose (Nginx) ───────────────────────────────────

# Internal service hostname and port used by Nginx reverse proxy
BACKEND_HOST=backend
BACKEND_PORT=8000
